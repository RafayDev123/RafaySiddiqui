# Public Google Cloud reCAPTCHA checkbox site key.
VITE_RECAPTCHA_SITE_KEY=your_google_cloud_checkbox_site_key

# Server-only verification settings. Restrict the API key to the reCAPTCHA Enterprise API.
RECAPTCHA_PROJECT_ID=your_google_cloud_project_id
RECAPTCHA_API_KEY=your_server_side_google_cloud_api_key
# Comma-separated exact hostnames; include localhost only for local testing.
RECAPTCHA_ALLOWED_HOSTNAMES=rafaysiddiqui.vercel.app

# EmailJS settings used only by the Vercel function.
EMAILJS_SERVICE_ID=service_xxxxx
EMAILJS_TEMPLATE_ID=template_xxxxx
EMAILJS_PUBLIC_KEY=your_emailjs_public_key